# ==============================================================================
# Legion Server Environment Variables
# Path: /home/legion/apps/docker/stack.env
# ==============================================================================

# User / Permissions
PUID=1000
PGID=1000
TZ=Asia/Kolkata
DOCKER_CONFIG_PATH=/home/legion/apps/docker

# Tailscale Auth Key
TS_AUTHKEY=tskey-auth-your-key-here

# LiteLLM Master & Encryption Keys
LITELLM_MASTER_KEY=sk-your-generated-master-key-here
LITELLM_SALT_KEY=your-generated-salt-key-here

# Cloud LLM API Keys (Populate the ones you use)
ANTHROPIC_API_KEY=sk-ant-api03-XXXXX
OPENAI_API_KEY=sk-proj-XXXXX
GEMINI_API_KEY=AIzaSyXXXXX

# OpenWebUI Master Secret
WEBUI_SECRET_KEY=your-random-generated-secret-key
