# KryNet-Agni Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Core Configuration
# ===========================================
PUID=1000
PGID=1000
TZ=Asia/Kolkata

# Docker paths
DOCKER_CONFIG_PATH=/path/to/docker/configs

# ===========================================
# Cloudflare & DNS
# ===========================================
# Cloudflare API Token (for DNS-01 challenge)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Tunnel Token
CF_TOKEN=your_cloudflare_tunnel_token

# ===========================================
# Tailscale VPN
# ===========================================
# Tailscale Auth Key (ephemeral or reusable)
TS_AUTHKEY=your_tailscale_auth_key_here
TS_HOSTNAME=homelab-network
LAN_SUBNET=192.168.1.0/24

# ===========================================
# AdGuard Home Sync
# ===========================================
ADGUARD_PRIME_PASSWORD=your_prime_adguard_password
ADGUARD_AGNI_PASSWORD=your_agni_adguard_password

# ===========================================
# Monitoring
# ===========================================
# Healthchecks configuration
HEALTHCHECK_URL=https://hc.example.com
HEALTHCHECK_DOMAIN=hc.example.com
HEALTHCHECK_INTERNAL_DOMAIN=hc.internal.home
SERVER_IP=192.168.1.200
ADMIN_EMAIL=admin@example.com

# Admin passwords
GOTIFY_ADMIN_PASS=your_admin_password

# ===========================================
# Backup Configuration
# ===========================================
BACKUP_REMOTE=your-rclone-remote
HC_AGNI_UUID=your-healthcheck-uuid-here

# ===========================================
# Dashboard
# ===========================================
HOMEPAGE_ALLOWED_HOSTS=home.example.com,home.internal.home,127.0.0.1
