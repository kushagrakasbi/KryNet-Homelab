# KryNet-Prime Environment Variables
# Copy this file to stack.env and fill in your values

# ===========================================
# Core Configuration
# ===========================================
PUID=568
PGID=568
TZ=Asia/Kolkata

# Docker paths
DOCKER_CONFIG_PATH=/mnt/storage/apps-config
DOCKER_DATA_PATH=/mnt/storage/data
APP_DATA_PATH=/mnt/storage/apps
DOCKER_TRANSCODE_CACHE=/mnt/cache/tdarr-cache

# ===========================================
# Immich Photo Management
# ===========================================
IMMICH_VERSION=release
IMMICH_UPLOAD_PATH=/mnt/storage/immich
DB_PASSWORD=your_database_password
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# ===========================================
# VPN Configuration (Gluetun)
# ===========================================
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key
WIREGUARD_ADDRESSES=10.x.x.x/32
SERVER_COUNTRIES=Netherlands
LAN_SUBNET=192.168.1.0/24

# ===========================================
# Jellyfin Media Server
# ===========================================
JELLYFIN_URL=media.example.com

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_PASS=your_postgres_password
DB_HOST=192.168.1.100

# ===========================================
# Speed Test Tracker
# ===========================================
SPEEDTEST_APP_KEY=base64:your_app_key_here

# ===========================================
# Homarr Dashboard
# ===========================================
# Generate with: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=your_secret_encryption_key_here

# ===========================================
# Tailscale VPN
# ===========================================
TS_AUTHKEY=your_tailscale_auth_key

# ===========================================
# Backup Configuration
# ===========================================
HEALTHCHECK_URL=https://hc.example.com
BACKUP_REMOTE=your-rclone-remote
HC_PRIME_UUID=your-healthcheck-uuid-here
