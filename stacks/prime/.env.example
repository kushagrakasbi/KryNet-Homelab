# Prime TrueNAS SCALE Environment Variables Template
PUID=568
PGID=568
TZ=Asia/Kolkata
DOCKER_CONFIG_PATH=/mnt/orion/apps-config
DOCKER_DATA_PATH=/mnt/orion/data
DOCKER_TRANSCODE_CACHE=/mnt/orion/apps-config/temp

# Surfshark / WireGuard VPN Configuration
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here
WIREGUARD_ADDRESSES=10.x.x.x/32
SERVER_COUNTRIES=Singapore

# Database Credentials
DB_PASSWORD=your_secure_db_password_here
JELLYSTAT_DB_PASSWORD=your_jellystat_db_password_here
JELLYSTAT_JWT_SECRET=your_jellystat_jwt_secret_here

# Immich Remote ML Offload
IMMICH_MACHINE_LEARNING_URL=http://192.168.0.150:3003
